# PaceLine Local: generate 32 random bytes, then base64 encode them. This
# encrypts local activity payloads and must never be committed.
PACELINE_ENCRYPTION_KEY=
PACELINE_ACTIVITY_DB_PATH=.local-data/activities.sqlite

# Optional: enables power-derived IF, training load, CTL, ATL, TSB, and zones.
PACELINE_FTP_WATTS=
