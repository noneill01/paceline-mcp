# Register an app at https://www.strava.com/settings/api, then keep the real
# values in a local .env file. Never commit the real values.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Local private-alpha storage: generate 32 random bytes, then base64 encode
# them. This value encrypts the local workout store and must never be committed.
TRAINING_COACH_ENCRYPTION_KEY=
TRAINING_COACH_DB_PATH=.local-data/training-coach.sqlite
